APP_NAME="Despacho Legal CR"
APP_ENV=local
APP_KEY=
# Opcional: clave HMAC para búsqueda de cédulas (por defecto APP_KEY)
# HMAC_KEY=
APP_DEBUG=true
# En producción: APP_DEBUG=false
APP_TIMEZONE=America/Costa_Rica
APP_URL=http://localhost

# Subí este número tras cambios de CSS/JS/Livewire para romper caché del navegador (?v=).
ASSET_VERSION=1

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local demo: sqlite. Producción: mysql
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=despacho_legal
# DB_USERNAME=despacho
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# false en local HTTP; en producción con HTTPS: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@despacholegal.cr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# IA (opcional). Sin clave se usa FakeAiService.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Backups (spatie/laravel-backup). En producción definir contraseña del ZIP.
# BACKUP_ARCHIVE_PASSWORD=

# Producción (checklist):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tu-dominio
# SESSION_SECURE_COOKIE=true
# DB_CONNECTION=mysql
# QUEUE_CONNECTION=database (o redis) + worker: php artisan queue:work
# Scheduler (cron): * * * * * cd /ruta && php artisan schedule:run
